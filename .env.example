# Скопируй этот файл в .env и вставь свои значения из Supabase.
# Где взять: Supabase → Project Settings → API Keys.
# Настоящие значения храни только в .env — он уже добавлен в .gitignore.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_key

# Для персонажа «Малое Солнце»: https://aistudio.google.com/apikey
# Ключ без VITE_ не попадёт во фронтенд.
GEMINI_API_KEY=your_gemini_api_key
